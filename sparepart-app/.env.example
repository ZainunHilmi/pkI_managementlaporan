# Database (CockroachDB) — SRS §4
# connection_limit + pool_timeout wajib diisi agar tidak P2024
# (pool timeout) saat banyak halaman diakses bersamaan / navigasi cepat.
DATABASE_URL="postgresql://user:pass@host:26257/sparepart_db?sslmode=verify-full&connection_limit=10&pool_timeout=20&connect_timeout=20"

# NextAuth — SRS §4
NEXTAUTH_SECRET="ganti-dengan-random-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ImgBB (lama, hanya untuk baris gambar lama) — SRS §4
IMGBB_API_KEY="your-imgbb-api-key"

# ImageKit.io (host gambar aktif) — daftar di imagekit.io, lalu
# Dashboard → Developer options → salin Private key + URL endpoint.
IMAGEKIT_PRIVATE_KEY="isi-dengan-private-key"
IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/xxxx"
IMAGEKIT_FOLDER="sparepart"

# Seed admin awal (opsional, hanya dipakai saat npm run db:seed)
# Jika dikosongkan, default: admin@sparepart.local / Administrator / Admin12345
# SEED_ADMIN_EMAIL="admin@sparepart.local"
# SEED_ADMIN_NAME="Administrator"
# SEED_ADMIN_PASSWORD="Admin12345"
